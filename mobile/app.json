{
  "expo": {
    "name": "Bubble",
    "slug": "bubble-mobile",
    "version": "0.2.0",
    "buildNumber": "2",
    "scheme": "bubble",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.trybubble.app",
      "associatedDomains": [
        "applinks:trybubble.io"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Bubble needs access to your photos so you can upload profile pictures, share images in your communities, and add photos to events.",
        "NSCameraUsageDescription": "Bubble needs access to your camera so you can take photos to share in your communities and events.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.trybubble.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "trybubble.io",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "trybubble.io",
              "pathPrefix": "/e/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-image",
      "expo-sharing",
      "./plugins/withSoLoaderInit",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REVERSED_CLIENT_ID"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "87aa84ba-0626-4ec1-b569-7276843813d9"
      }
    }
  }
}
