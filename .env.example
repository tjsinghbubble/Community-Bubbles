# Root .env — copy to .env and fill in. This file is committed (placeholders only);
# the real .env is gitignored. These are SERVER-side values; never expose them to
# client code. (Mobile client vars live in mobile/.env — see mobile/.env.example.)
# Full guidance: docs/SECRETS_MANAGEMENT.md.

# ============================================================================
# REQUIRED — the server will not start (or will misbehave) without these.
# ============================================================================

# Postgres connection. Default uses localhost; the named-host model maps `db_host`
# to a real address per environment (see docs/dev-hosts.md).
DATABASE_URL=postgresql://<user>@localhost:5432/bubble_dev

# Secret for signing JWTs. Use a long random string (do NOT reuse across envs).
#   generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_string

# Symmetric encryption key. Validated at startup — must be 32 bytes as 64 hex chars.
#   generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# Port the API server listens on.
API_WEB_SERVER_PORT=3000

# ============================================================================
# CometChat (server-side). The APP_ID/REGION mirror the client values; the
# AUTH_KEY and REST API_KEY are server-only secrets — never ship them to a client.
# ============================================================================
COMETCHAT_APP_ID=YOUR_COMETCHAT_APP_ID
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=YOUR_COMETCHAT_AUTH_KEY
COMETCHAT_API_KEY=YOUR_COMETCHAT_REST_API_KEY

# ============================================================================
# OPTIONAL — features degrade gracefully if unset.
# ============================================================================

# Node environment (development | production). Defaults to development locally.
NODE_ENV=development

# Email (Resend). Needed only for outbound email (verification, password reset).
RESEND_API_KEY=
EMAIL_FROM=

# Error monitoring (Sentry). In local dev Sentry is suppressed unless you opt in:
#   set BUBBLE_SENTRY_USAGE=local AND provide SENTRY_DSN. See server/sentry.ts.
SENTRY_DSN=
BUBBLE_SENTRY_USAGE=

# Base URL used when generating shareable links.
SHARE_BASE_URL=

# CORS allow-lists (comma-separated origins). Leave unset for permissive local dev.
ALLOWED_ORIGINS=
ALLOWED_PHOTO_ORIGINS=

# Object storage (Replit object store). Needed only for uploads/media.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Google/Apple sign-in on WEB. Public client identifiers (not secrets), but kept
# server-side since the server is what verifies tokens against them. Unset =
# the web welcome page falls back to its existing "isn't set up yet" notice.
#   GOOGLE_CLIENT_ID_WEB — a "Web application" OAuth 2.0 Client ID from Google
#     Cloud Console (Credentials), NOT the iOS/Android client IDs mobile uses —
#     those are a different client type and won't verify web-issued tokens.
#     Add this server's origin (e.g. http://localhost:5000 for local dev) as an
#     Authorized JavaScript origin on that client.
#   APPLE_SERVICES_ID — the Services ID from Apple Developer > Certificates,
#     Identifiers & Profiles, configured for "Sign in with Apple" with this
#     server's HTTPS origin as a registered Return URL. Apple's JS SDK does not
#     work on http://localhost — this can only be tested on a deployed domain.
#   APPLE_BUNDLE_ID — defaults to io.trybubble.app (the native app's bundle ID,
#     used to verify tokens from the mobile app). Only override if that changes.
GOOGLE_CLIENT_ID_WEB=
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=

# Rate limiting (sane defaults applied in code if unset).
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_WINDOW_MIN=
RATE_LIMIT_SEND_MAX=
RATE_LIMIT_SEND_WINDOW_MIN=

# Monitoring / retention tuning (defaults applied if unset).
SLOW_CALL_THRESHOLD_MS=
SLOW_CALL_RETENTION_DAYS=
LATENCY_RETENTION_DAYS=
CRASH_REPORT_RETENTION_DAYS=
FATAL_CRASH_SPIKE_THRESHOLD=
FATAL_CRASH_SPIKE_WINDOW_MINUTES=

# End-to-end test target (testing only).
E2E_BASE_URL=
