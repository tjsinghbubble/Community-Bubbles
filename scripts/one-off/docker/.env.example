# Bubble local experiment stack env — copy to .env.local and fill in.
# Derived from the server env audit (docs/research/dockerization-plan.md has the full table).
# NEVER commit .env.local.

# --- required: server refuses to boot in prod mode without these ---
JWT_SECRET=change-me-local-only
ENCRYPTION_KEY=            # openssl rand -hex 32

# --- CometChat (chat SaaS); dummy values boot but chat endpoints fail ---
EXPO_PUBLIC_COMETCHAT_APP_ID=
EXPO_PUBLIC_COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=
COMETCHAT_API_KEY=

# --- object storage paths (bucket layout inside GCS/fake-gcs) ---
PRIVATE_OBJECT_DIR=/bubble-local/private
PUBLIC_OBJECT_SEARCH_PATHS=/bubble-local/public

# --- optional ---
#RESEND_API_KEY=
#EMAIL_FROM=
#SENTRY_DSN=
#SHARE_BASE_URL=http://localhost:5000
#ALLOWED_ORIGINS=
#ALLOWED_PHOTO_ORIGINS=
#SEED_SECRET=local-seed-secret
